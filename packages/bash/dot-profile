
# Configuration for programs running under dash/sh and login shells

# if /data/cache exists, use it for XDG_CACHE_HOME
# Generally this will some kind of fast drive at /data
[ -d /data/cache ] && export XDG_CACHE_HOME=/data/cache

# set XDG dirs to their defaults.  Not strictly necessary for cache, config, state and data, but
# set in case apps are poorly written.
[ "$XDG_CACHE_HOME" ] || export XDG_CACHE_HOME=${HOME}/.cache
[ "$XDG_CONFIG_HOME" ] || export XDG_CONFIG_HOME=${HOME}/.config
[ "$XDG_DATA_HOME" ] || export XDG_DATA_HOME=${HOME}/.local/share
[ "$XDG_STATE_HOME" ] || export XDG_STATE_HOME=${HOME}/.local/state
[ -d $XDG_DATA_HOME ] || mkdir -p $XDG_DATA_HOME
[ -d $XDG_CACHE_HOME ] || mkdir -p $XDG_CACHE_HOME
[ -d $XDG_CONFIG_HOME ] || mkdir -p $XDG_CONFIG_HOME
[ -d $XDG_STATE_HOME ] || mkdir -p $XDG_STATE_HOME

# load common defines (mainly environment variables)
[ -e ${XDG_CONFIG_HOME}/bash/shell-defines.sh ] && source ${XDG_CONFIG_HOME}/bash/shell-defines.sh

# load site profile settings
[ -e ${XDG_DATA_HOME}/site-profile ] && source ${XDG_DATA_HOME}/site-profile

# source bash for interactive logins
if [ -n "$BASH_VERSION" ] && [ -n "$PS1" ]; then
    [ -f "$HOME/.bashrc" ] && source "$HOME/.bashrc"
fi
