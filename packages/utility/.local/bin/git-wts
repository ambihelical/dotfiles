#!/usr/bin/env bash
set -euo pipefail

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Not inside a git repository"
    exit 1
}

git fetch --all --prune --quiet || true

# Parent directory of the current worktree
current=$(git rev-parse --show-toplevel)
parent=$(dirname "$current")

printf "%-15s %-20s %-40s\n" "Status" "Worktree" "Branch"
echo "-----------------------------------------------------------------------------"

git worktree list --porcelain | awk '/^worktree /{print $2}' |
while read -r wt; do

    # Strip parent prefix
    name="${wt#$parent/}"

    # Mark current worktree as "."
    #[[ "$wt" == "$current" ]] && name="."

    branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "DETACHED")
    upstream=$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)

    ahead=0; behind=0
    if [[ -n "$upstream" ]]; then
        read behind ahead < <(git -C "$wt" rev-list --left-right --count "$upstream"...HEAD)
    fi

    status=$(git -C "$wt" status --porcelain)

    flags=""
    grep -qE '^[A-Z]' <<<"$status"  && flags+="S"
    grep -qE '^.[A-Z]' <<<"$status" && flags+="M"
    grep -qE '^\?\?' <<<"$status"   && flags+="U"
    [[ -z "$flags" ]] && flags="-"

    # Truncate branch to 40 chars
    if (( ${#branch} > 40 )); then
        branch="${branch:0:37}..."
    fi

    printf "[%-3s ↑%-3d ↓%-3d] %-20s %-40s\n" \
        "$flags" "$ahead" "$behind" "$name" "$branch"
done
echo "-----------------------------------------------------------------------------"
echo "Status: S=staged, M=modified, U=untracked ↑=ahead  ↓=behind"
