#!/bin/bash

if [ $# != 0 ]; then
	echo "No arguments needed"
	exit 1
fi

# more error checking
set -euo pipefail

# flags for repos (exact mirror)
# exclude rust target directories
GFLAGS="--archive --verbose --delete --exclude target/ --exclude doc/out/  --exclude dotfiles/"

# flags for plain files
PFLAGS="--archive --verbose"

# flags for config files (firefox is a bunch of non-config shit, and who cares anyway)
CFLAGS="--archive --verbose --exclude firefox"
OTHER=/run/media/eric/fedora_localhost-live/${HOME}

if [ ! -d ${OTHER} ]; then
    echo "Can't find Backup parent ${OTHER}, is drive mounted?"
    exit -1
fi

DEST=${OTHER}/Backup/
mkdir -p ${DEST}

SRC=${HOME}/dev/
rsync ${GFLAGS} ${SRC} ${DEST}

SRC=${HOME}/.config
rsync ${CFLAGS} ${SRC} ${DEST}

SRC=${HOME}/personal
rsync ${PFLAGS} ${SRC} ${DEST}
