#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: git wta <issue-number>"
    exit 1
fi

issue="$1"

git fetch origin --prune >/dev/null 2>&1

mapfile -t matches < <(
    git for-each-ref --format='%(refname:short)' refs/remotes/origin |
    sed 's|^origin/||' |
    grep -E "^[^-]+-${issue}(-|$)"
)

count=${#matches[@]}

if (( count == 0 )); then
    echo "No branches found with issue $issue"
    exit 1
elif (( count > 1 )); then
    echo "Multiple matching branches:"
    printf "  %s\n" "${matches[@]}"
    exit 1
fi

branch="${matches[0]}"
dir="../${issue}"

echo "Creating worktree:"
echo "  branch: $branch"
echo "  dir:    $dir"

git worktree add "$dir" "$branch"