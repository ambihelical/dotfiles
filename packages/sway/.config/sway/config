# class                 border  backgr  text    indicator
client.focused          $yellow $yellow $black  $violet
client.focused_inactive $blue   $blue   $lite3  $violet
client.unfocused        $dark3  $dark1  $lite3  $violet
client.urgent           $red    $red    $dark2  $red

# status bar
bar {
    swaybar_command waybar
}

# turn off scrolling to select window
bindsym button4 nop
bindsym button5 nop

# repeat workplace command to go back
workspace_auto_back_and_forth yes

# default to stacking layout
workspace_layout stacking

# turn off urgency hint a few seconds after switching to workspace
force_display_urgency_hint 2000 ms

# scatchpad
bindsym $mod+Shift+minus  move scratchpad
bindsym $mod+minus scratchpad show

# assignments

# old school class to set title
for_window [class="Emacs"] title_format "<span foreground='aquamarine1' font_weight='bold'><span font='Symbola Bold 12'>ℰ</span> %title</span>"
for_window [class="Git-gui"] title_format "<span foreground='plum'><span font='Symbola Bold 12'>Ⓖ</span> %title</span>"
for_window [class="Gitk"] title_format "<span foreground='plum'><span font='Symbola Bold 12'>⌥</span> %title</span>"
for_window [class="XTerm"] title_format "<span foreground='light steel blue' font_weight='bold'><span font='Symbola Bold 12'>↵</span> %title</span>"
# new school app_id to set titles
for_window [app_id="foot"] title_format "<span foreground='light steel blue' font_weight='bold'><span font='Symbola Bold 12'>↵</span> %title</span>"
for_window [app_id="org.mozilla.firefox"] title_format "<span foreground='light salmon'><span font='Symbola Bold 12'>☯</span> %title</span>"
for_window [app_id="org.gnome.Nautilus"] title_format "<span font='Symbola Bold 12'>📂</span> %title"
for_window [app_id="evince"] title_format "<span font='Symbola Bold 12'>Ⓟ</span> %title"
for_window [app_id="org.gnome.SystemMonitor"] title_format "<span font='Symbola Bold 12'>🩺</span> %title"

# floating windows
for_window [title="sway-scratch"] floating enable, move scratchpad, scratchpad show, resize set 640 480, move position center, scratchpad show
for_window [app_id="qalculate-gtk"] floating enable
for_window [app_id="org.gnome.Calendar"] floating enable, border pixel 3
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable


# convenient key bindings
bindsym $mod+slash exec xdg-open . &
bindsym $mod+b exec firefox &
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume 1 -- +5% && killall -SIGUSR1 i3status
bindsym XF86AudioLowerVolume exec pactl set-sink-volume 1 -- -5% && killall -SIGUSR1 i3status
bindsym XF86AudioMute exec pactl set-sink-mute 1 toggle
bindsym $mod+equal exec sh -c 'pkill -x qalculate-gtk ||  qalculate-gtk&'
bindsym XF86Calculator exec sh -c 'pkill -x qalculate-gtk ||  qalculate-gtk&'
bindsym XF86Mail [class="Thunderbird"] focus
bindsym Shift+XF86Mail [class="Pidgin"] focus
bindsym XF86Tools [class="Pithos"] focus
bindsym XF86HomePage [class="Firefox"] focus
#bindsym $mod+m exec i3-input -F 'mark %s' -l 1 -P 'Mark: '
#bindsym $mod+g exec i3-input -F '[con_mark="%s"] focus' -l 1 -P 'Go to: '
#bindsym $mod+w exec i3-input -F 'rename workspace to "%s"' -P 'Workspace name: '

# copy primary selection to clipboard
bindsym $mod+Shift+c exec wl-paste --primary | wl-copy 
# clipman paste
bindsym $mod+Shift+v exec 'clipman pick -t wofi && wtype -M ctrl -M shift v'

# send new clipboard contents to clipman
exec wl-paste -t text --watch clipman store --no-persist --max-items=30 --min-char 10 &

set $lockit 'swaylock --daemonize --color=000000'

exec swayidle -w timeout 3600 $lockit before-sleep $lockit &

set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (Shift+s) shutdown
mode "$mode_system" {
    bindsym l exec $lockit, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym s exec ~/bin/power-control suspend, mode "default"
    bindsym h exec ~/bin/power-control hibernate, mode "default"
    bindsym r exec ~/bin/power-control restart
    bindsym Shift+s exec ~/bin/power-control shutdown

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+BackSpace mode "$mode_system"

# Note: get inputs with swaymsg -t get_inputs

input type:keyboard xkb_options caps:hyper,compose:rctrl
output HDMI-A-1 pos 1050 0
output DVI-I-1 pos 0 0 transform 270
output * scale 1

# authentication agent for policy kit
exec /usr/libexec/polkit-mate-authentication-agent-1 &

# scratch
exec $term --title "sway-scratch" &

# networking control tray app
exec nm-applet &

# plugin drive tray app
exec udiskie --tray --no-menu-update-workaround --no-notify &

# extra startup easier to do from shell
exec $xdgconf/sway/sway-extra-startup
