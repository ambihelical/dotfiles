#!/bin/bash
#
# Make sure some system packages are present. These are only the
# most basic packages needed to set up a basic system, plus a few
# nice-to-haves.
#
# strict mode
set -euo pipefail

# in case we need it...
script_path="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}
# Preconditions
need_cmd gsettings



# turn off the exposé function
gsettings set org.gnome.mutter overlay-key ''

# right control is compose
# caps lock is hyper
# windows key is super
gsettings set org.gnome.desktop.input-sources xkb-options "['caps:hyper', 'compose:rctrl']"

# sloppy focus with no auto-raise
gsettings set org.gnome.desktop.wm.preferences focus-mode 'sloppy'
gsettings set org.gnome.desktop.wm.preferences auto-raise false
gsettings set org.gnome.desktop.wm.preferences raise-on-click true

# don't scale text
gsettings set org.gnome.desktop.interface text-scaling-factor 1

# remove super bindings gnome rudely steals. We need these for emacs
for schema in $(gsettings list-schemas); do
  for key in $(gsettings list-keys "$schema"); do
    val=$(gsettings get "$schema" "$key" 2>/dev/null)
    if echo "$val" | grep -q '<Super>'; then
      echo "Clearing $schema $key"
      gsettings set "$schema" "$key" "[]"
    fi
  done
done
