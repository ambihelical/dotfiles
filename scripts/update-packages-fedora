#!/bin/bash
#
# Make sure some system packages are present. These are only the
# most basic packages needed to set up a basic system, plus a few
# nice-to-haves.
#
# strict mode
set -euo pipefail

# in case we need it...
script_path="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}
# Preconditions
need_cmd sudo
need_cmd dnf

# Pre-authenticate sudo once
sudo -v

# base packages
pkgs=(
    autoconf
    autojump
    automake
    clangd
    emacs
    git
    gitk
    pkg-config
    rclone
    ripgrep
    stow
    tree
    vim
)

# extras for any desktop
pkgs+=(
     alacritty
     foot
     gnome-calendar
     qalculate-gtk
     okular
)

# fonts
pkgs+=(
    adobe-source-sans-pro-fonts
    dejavu-fonts-all
    google-roboto-fonts
    fontawesome-fonts-all
)

# wayland & sway specific
pkgs+=(
    brightnessctl
    clipman
    grim
    j4-dmenu-desktop
    pavucontrol
    playerctl
    slurp
    sway
    swaybg
    swayidle
    swaylock
    udiskie
    waybar
    wayland-utils
    wev
    wl-clipboard
    wlrctl
    wlr-randr
    wtype
    wofi
    xdg-desktop-portal-wlr
)


sudo dnf install "${pkgs[@]}"


