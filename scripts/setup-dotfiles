#!/bin/bash
#
# Make sure some system packages are present. These are only the
# most basic packages needed to set up a basic system, plus a few
# nice-to-haves.
#
# strict mode
set -euo pipefail

# in case we need it...
script_path="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}
# Preconditions
need_cmd stow
need_cmd git


# stow packages
pkgs=(
    bash emacs git readline ripgrep vim utility
    sway waybar starship
)

# set the user and email for this repo only
git config --unset-all --local user.name 2>/dev/null || true
git config --unset-all --local user.email 2>/dev/null || true
git config --unset-all --local github.user 2>/dev/null || true
git config --add --local user.name "ambihelical"
git config --add --local user.email "ambihelical@users.noreply.github.com"
git config --add --local github.user "ambihelical"


# we may have ran vim already, so move the viminfo file if
# it exists
mkdir -p ~/.cache/vim
[ -e ~/.viminfo ] && mv -f ~/.viminfo ~/.cache/vim/viminfo

stow --dotfiles -t $HOME -d $script_path/../packages "${pkgs[@]}"
