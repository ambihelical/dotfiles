#!/bin/bash
#
# Make sure some system packages are present. These are only the
# most basic packages needed to set up a basic system, plus a few
# nice-to-haves.
#
# strict mode
set -euo pipefail

# in case we need it...
script_path="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}
# Preconditions
need_cmd sudo
need_cmd apt-get

# Pre-authenticate sudo once
sudo -v

# base packages
pkgs=(
    build-essential autoconf automake stow pkg-config
    autojump clangd ripgrep tree
    git gitk
    vim emacs
)

# desktop, especially for sway
pkgs+=(
    qalculate-gtk
    sway waybar dmenu rofi
)

#udiskie dunst wmctrl


sudo apt-get update
sudo apt-get install -y --ignore-missing "${pkgs[@]}"


