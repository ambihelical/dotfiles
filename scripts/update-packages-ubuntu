#!/bin/bash
#
# Make sure some system packages are present. These are only the
# most basic packages needed to set up a basic system, plus a few
# nice-to-haves.
#
# strict mode
set -euo pipefail

# in case we need it...
script_path="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}
# Preconditions
need_cmd sudo
need_cmd apt-get

# Pre-authenticate sudo once
sudo -v

# base packages
pkgs=(
    build-essential autoconf automake stow pkg-config
    autojump clangd ripgrep tree
    git gitk
    vim emacs
)

# extras for any desktop
pkgs+=(
    foot alacritty
    pavucontrol udiskie brightnessctl playerctl
    fonts-dejavu fonts-noto fonts-font-awesome fonts-roboto
    qalculate-gtk
)

# desktop, especially for sway
pkgs+=(
    wayland-protocols xwayland wl-clipboard wlrctl wtype xdg-desktop-portal-wlr mako-notifier
    wayland-utils wlr-randr
    sway swaybg swayidle swaylock waybar
    grim slurp foot wofi
    pavucontrol udiskie brightnessctl playerctl clipman
    j4-dmenu-desktop
)



sudo apt-get update
sudo apt-get install -y --ignore-missing "${pkgs[@]}"


