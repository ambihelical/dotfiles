# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	output_format = "i3bar"
	colors = true
	interval = 5
}

order += "disk /media/FLASHDRIVE"
order += "disk /media/DEVO"
order += "disk /"
order += "disk /home"
order += "disk /data"
order += "ethernet eth0"
order += "ethernet eth1"
order += "ethernet enp5s0"
order += "ethernet enp6s0"
order += "ethernet tun0"
order += "wireless wlan0"
order += "wireless wlp3s0"
order += "wireless wlp5s0"
order += "volume master"
order += "cpu_usage"
order += "load"
order += "battery 0"
order += "time"

wireless wlan0 {
	format_up = "[wlan0]—▸%essid:%quality"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}
wireless wlp3s0 {
	format_up = "[wlp3s0]—▸%essid:%quality"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}
wireless wlp5s0 {
	format_up = "[wlp5s0]—▸%essid:%quality"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}

ethernet eth0 {
	format_up = "[eth0]—▸%ip"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}
ethernet eth1 {
	format_up = "[eth1]—▸%ip"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}
ethernet enp5s0 {
	format_up = "[enp5s0]—▸%ip"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}
ethernet enp6s0 {
	format_up = "[enp6s0]—▸%ip"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}
ethernet tun0 {
	format_up = "[VPN]—▸%ip"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:nm-connection-editor || exec nm-connection-editor"
}

battery 0 {
	format = "[🗲]—▸%percentage"
	format_down = ""
	on_click 1 = "exec wlrctl window close app_id:gnome-power-statistics || exec gnome-power-statistics"
}

time {
	format = "[📅]—▸%a %d %b %I:%M %p"
	on_click 1 = "exec wlrctl window close app_id:org.gnome.Calendar || gnome-calendar "
}

disk "/" {
	format = "[/]—▸%free"
	on_click 1 = "exec xdg-open /"
}
disk "/home" {
	format = "[/home]—▸%free"
	on_click 1 = "exec xdg-open /home"
	format_not_mounted = ""
}
disk "/data" {
	format = "[/data]—▸%free"
	on_click 1 = "exec xdg-open /data"
	format_not_mounted = ""
}

volume master {
	format = "[🔊]—▸%volume"
	format_muted = "[🔊]—▸%volume"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
	on_click 1 = "exec wlrctl window close app_id:org.pulseaudio.pavucontrol || pavucontrol"
	on_click 2 = "exec pactl -- set-sink-mute 1 toggle"
	on_click 3 = "exec pactl -- set-sink-mute 1 toggle"
	on_click 4 = "exec pactl -- set-sink-volume 1 +2%"
	on_click 5 = "exec pactl -- set-sink-volume 1 -2%"
}

cpu_usage {
	format = "[⚙]—▸%usage"
	on_click 1 = "exec wlrctl window close app_id:org.gnome.SystemMonitor || gnome-system-monitor"
}

load {
	format = "[🔥]—▸%1min"
	on_click 1 = "exec wlrctl window close app_id:org.gnome.SystemMonitor || gnome-system-monitor"
}
 
cpu_temperature 0 {
	format = "%degrees°"
	path = "/sys/devices/platform/coretemp.0/temp2_input"
	max_threshold = 95
}
 
cpu_temperature 1 {
	format = "%degrees°"
	path = "/sys/devices/platform/coretemp.0/temp3_input"
	max_threshold = 95
}
 
cpu_temperature 2 {
	format = "%degrees°"
	path = "/sys/devices/platform/coretemp.0/temp4_input"
	max_threshold = 95
}
 
cpu_temperature 3 {
	format = "%degrees°"
	path = "/sys/devices/platform/coretemp.0/temp5_input"
	max_threshold = 95
}
